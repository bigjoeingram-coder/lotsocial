RESEND_API_KEY=
EMAIL_FROM=
ENFORCEMENT_API_KEY=

# Bright Data Web Unlocker — VDP extraction fallback (app/lib/vdp.ts).
# fetchViaBrightData() returns null silently when either of these is unset,
# which disables the fallback entirely. Both MUST be set in production:
#   npx wrangler secret put BRIGHTDATA_API_KEY
#   npx wrangler secret put BRIGHTDATA_ZONE
# Account: customer hl_464f640c. Token: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
